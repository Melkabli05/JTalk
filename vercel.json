{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/v1/users/:path*",
      "destination": "https://jtalk-user-service.onrender.com/api/v1/users/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://live-communication-service.onrender.com/api/:path*"
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "destination": "/index.csr.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path((?!v1/users/[^/]+/avatar/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Accel-Buffering",
          "value": "no"
        }
      ]
    },
    {
      "source": "/index.csr.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|mjs|css|wasm|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(assets|avatars|brand|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/app/browser",
  "installCommand": "command -v bun && [ -f bun.lock ] && bun install || npm install --legacy-peer-deps --include=dev --include=optional"
}
